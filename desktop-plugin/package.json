{
  "name": "dsh-connect",
  "version": "1.0.14",
  "type": "module",
  "displayName": "DSH Connect",
  "description": "通过鸿蒙应用或浏览器连接电脑上的完整 DeepSeek Harness。",
  "license": "Apache-2.0",
  "author": "LUMIAO9527",
  "files": [
    "index.js",
    "client.js",
    "gateway-bootstrap.js",
    "mobile-client.js",
    "mobile.css",
    "brand.svg",
    "lib/brand.mjs",
    "lib/mobile-access/**",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "lib/configuration.mjs",
    "icon.svg",
    "lib/updates.mjs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "qrcode": "1.5.4",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check gateway-bootstrap.js && node --check mobile-client.js && node tools/sync-settings-icon.mjs --check",
    "test": "node test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LUMIAO9527/DSH-Connect.git",
    "directory": "desktop-plugin"
  },
  "homepage": "https://github.com/LUMIAO9527/DSH-Connect#readme",
  "bugs": {
    "url": "https://github.com/LUMIAO9527/DSH-Connect/issues"
  }
}
