{
  "name": "dsh-connect",
  "version": "1.2.4",
  "displayName": "DSH Connect",
  "description": "通过手机浏览器连接电脑上的完整 DeepSeek Harness。",
  "license": "Apache-2.0",
  "author": "LUMIAO9527",
  "files": [
    "desktop-plugin/index.js",
    "desktop-plugin/client.js",
    "desktop-plugin/gateway-bootstrap.js",
    "desktop-plugin/mobile-client.js",
    "desktop-plugin/mobile.css",
    "desktop-plugin/brand.svg",
    "desktop-plugin/lib/brand.mjs",
    "desktop-plugin/lib/icons.mjs",
    "desktop-plugin/lib/mobile-access/**",
    "desktop-plugin/cordis.patch.yml",
    "desktop-plugin/locale/*.json",
    "desktop-plugin/README.md",
    "desktop-plugin/LICENSE",
    "desktop-plugin/lib/configuration.mjs",
    "desktop-plugin/icon.svg",
    "desktop-plugin/lib/updates.mjs",
    "desktop-plugin/package.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./desktop-plugin/index.js",
    "./client": "./desktop-plugin/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./desktop-plugin/locale/*.json",
    "./icon": "./desktop-plugin/icon.svg"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "node-forge": "1.4.3",
    "qrcode": "1.5.4",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./desktop-plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "check": "node tools/sync-package.mjs --check && npm --prefix desktop-plugin run check",
    "test": "npm --prefix desktop-plugin test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LUMIAO9527/DSH-Connect.git"
  },
  "homepage": "https://github.com/LUMIAO9527/DSH-Connect#readme",
  "bugs": {
    "url": "https://github.com/LUMIAO9527/DSH-Connect/issues"
  },
  "main": "./desktop-plugin/index.js"
}
