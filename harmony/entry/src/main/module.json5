{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [{ "name": "ohos.arkui.UIMaterial.state", "value": "enable" }],
    "abilities": [{
      "name": "EntryAbility",
      "srcEntry": "./ets/entryability/EntryAbility.ets",
      "description": "$string:module_desc",
      "icon": "$media:app_icon",
      "label": "$string:app_name",
      "startWindowIcon": "$media:app_icon",
      "startWindowBackground": "$color:start_window_background",
      "exported": true,
      "skills": [{ "entities": ["entity.system.home"], "actions": ["ohos.want.action.home"] },
        { "entities": ["entity.system.browsable"], "actions": ["ohos.want.action.viewData"], "uris": [{ "scheme": "dshconnect", "host": "connect" }] }]
    }],
    "requestPermissions": [{ "name": "ohos.permission.INTERNET" }, { "name": "ohos.permission.GET_NETWORK_INFO" }]
  }
}
